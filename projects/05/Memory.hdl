CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    DMux4Way(in=load , sel=address[13..14] , a=toRamLoadA , b=toRamLoadB , c=toScreenLoad , d=toKeyboardNotUsedB );
    Or(a=toRamLoadA , b=toRamLoadB , out=toRamLoad );

	RAM16K(in=in , load=toRamLoad , address=address[0..13] , out=ramOut );
    Screen(in=in , load=toScreenLoad  , address=address[0..12] , out=screenOut );
    Keyboard(out=keyboardOut );

    Mux4Way16(a=ramOut , b=ramOut , c=screenOut , d=keyboardOut , sel=address[13..14] , out=out );

}
