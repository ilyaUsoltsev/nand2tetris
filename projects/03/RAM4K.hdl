// File name: projects/3/b/RAM4K.hdl
/**
 * Memory of 4K 16-bit registers.
 * If load is asserted, the value of the register selected by
 * address is set to in; Otherwise, the value does not change.
 * The value of the selected register is emitted by out.
 */
CHIP RAM4K {
    IN in[16], load, address[12];
    OUT out[16];

    PARTS:
    //// Replace this comment with your code.
    DMux8Way(in= load, sel= address[0..2], a= a0, b= a1, c= a2, d= a3, e= a4, f= a5, g= a6, h=a7 );

    RAM512(in= in, load= a0, address= address[3..11], out=r0 );
    RAM512(in= in, load= a1, address= address[3..11], out=r1 );
    RAM512(in= in, load= a2, address= address[3..11], out=r2 );
    RAM512(in= in, load= a3, address= address[3..11], out=r3 );
    RAM512(in= in, load= a4, address= address[3..11], out=r4 );
    RAM512(in= in, load= a5, address= address[3..11], out=r5 );
    RAM512(in= in, load= a6, address= address[3..11], out=r6 );
    RAM512(in= in, load= a7, address= address[3..11], out=r7 );

        Mux8Way16(
        a=r0,
        b=r1,
        c=r2,
        d=r3,
        e=r4,
        f=r5,
        g=r6,
        h=r7,
        sel=address[0..2],
        out=out
    );
}
