/**
BallsManager is responsible for managing the balls in the simulation. 
It handles the creation, movement, and rendering of the balls, as well as user input for adding and removing balls.
*/

class BallsManager {
    field int i;
    field BallList ballsArray;
    field Ball ball;
    field int x, y, r, vx, vy;
    field int length;
    field int xSpread;
    field int key;
    field boolean keyIsSet;

    constructor void new() {
        // Initialize the ball manager with three balls
        let length = 3;
        let ballsArray = BallList.new(length); 
        let i = 0;
        let xSpread = 25;
        let keyIsSet = false;
        let key = 0;
        do showCount();

        // poulate the ball list with initial balls
        while (i < length) {
            let x = 10 + (i * xSpread);
            let y = 100;
            let r = 10;
            let vx = (10-i); 
            let vy = (10+i); 
            let ball = Ball.new(x, y, r, vx, vy);
            do ballsArray.push(ball); 
            let i = i + 1;
        }
        return this;
    }

    method void run() {
        while (true) {
            let i = 0;
            
            while (i < length) {
                let ball = ballsArray.get(i);
                if (~(ball = null)) {
                    do ball.erase();
                }
                let i = i + 1;
            }
                let i = 0;
            while (i < length) {
                let ball = ballsArray.get(i);
                if (~(ball = null)) {
                    do ball.run();
                }
                let i = i + 1;
            }

            let key = Keyboard.keyPressed();

            if((key = 131) & (~keyIsSet)) {
                // limit the number of balls to 50 to prevent performance issues
                if (length < 50) { 
                    let ball = Ball.new(100+length, 40+length, 10, -length+5, -length+8); 
                    do ballsArray.push(ball);
                    let length = length + 1;
                    let keyIsSet = true;
                    do showCount();
                }
            }


            if((key = 133) & (~keyIsSet)) {
                let ball = ballsArray.pop();
                if (~(ball = null)) {
                    do ball.erase();
                    do ball.dispose();
                }
                if (length > 0) {
                    let length = length - 1;
                }
                let keyIsSet = true;
                do showCount();
            }

            if(key = 0) {
                let keyIsSet = false;
            }

            do Sys.wait(50);
        }
        return;
    }

    method void dispose() {
        let i = 0;
        while (i < length) {
            let ball = ballsArray.get(i);
            if (~(ball = null)) {
                do ball.dispose();
            }
            let i = i + 1;
        }
        return;
    }

    method void showCount() {
        do Output.moveCursor(2, 7);
        do Output.printString("Use Up/Down. Ball count: ");
        do Output.printInt(length);
        return;
    }
}
