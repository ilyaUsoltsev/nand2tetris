/**
 The Draw class represents a drawable circle on the screen. 
 The class provides methods to set the position and size of the circle, 
 draw it on the screen, erase it, and dispose of the object when it is no longer needed.
*/

class Draw {
    field int x, y, size;
    field boolean isDrawing;

    constructor void new() {
        let x = 0;
        let y = 0;
        let size = 0;
        let isDrawing = false;
        return this;
    }

    method void setPosition(int ax, int ay) {
        let x = ax;
        let y = ay;
        return;
    }

    method void setSize(int asize) {
        let size = asize;
        return;
    }

    method void draw() {
      do Screen.setColor(true);
      do Screen.drawCircle(x, y, size);
      return;
   }

   method void erase() {
      do Screen.setColor(false);
      do Screen.drawCircle(x, y, size);
      return;
   }

    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }
}
