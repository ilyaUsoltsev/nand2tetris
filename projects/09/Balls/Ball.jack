/**
 Ball class represents a single ball in the animation. 
 It maintains the ball's position, velocity, and size, 
 and provides methods to update its position based on its velocity, 
 handle collisions with the boundaries of the screen, 
 and draw itself on the screen using a Draw object.
*/


class Ball {
    field Draw draw;
    field int x, y, r;
    field int vx, vy;
    field int velocityFactor;

    constructor Ball new(int Ax, int Ay, int Ar, int Avx, int Avy) {
        let velocityFactor = 1;
        let x = Ax;
        let y = Ay;
        let r = Ar;
        let vx = Avx;
        let vy = Avy;
        let draw = Draw.new();
        do draw.setPosition(x, y);
        do draw.setSize(r);

        return this;
    }


    method void run() {
   
        do draw.setPosition(x, y);
        let x = x + (vx * velocityFactor);
        let y = y + (vy * velocityFactor);
        if (((x + r) > 512) | ((x - r) < 0)) {
            let vx = -vx;
            let x = x + (vx * velocityFactor);
        }
        if (((y + r) > 256) | ((y - r) < 0)) {
            let vy = -vy;
            let y = y + (vy * velocityFactor);
        }
        do draw.draw();
        
        
        return;
    }

    method void erase(){
        do draw.erase();
        return;
    }

    method void dispose() {
        do draw.dispose();
        return;
    }
}
