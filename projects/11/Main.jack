// Inputs some numbers and computes their average
class Point {
   field int x, y;
   static int pointCount;

   method int distanceFromOrigin(int aX, Point p) {
      var int x2, y2;
      let x2 = x * x + aX * aX;
      let y2 = y * y;
      let px2 = p + aX;
      let py2 = p + y2;
      return x2 + y2 + px2 + py2;
   }
}  
