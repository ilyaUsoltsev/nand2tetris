
CHIP Mux4Way16 {

    IN a[16], b[16], c[16], d[16], sel[2];
    OUT out[16];
    
    PARTS:

    Not(in= sel[0], out=notSel0 );
    Not(in= sel[1], out=notSel1 );
    And(a= notSel0, b= notSel1, out=isA);
    And(a= notSel0, b= sel[1], out=isC);
    And(a= sel[0], b= notSel1, out=isB);
    And(a= sel[0], b= sel[1], out=isD);

    Not16(in= a, out=notA16 );
    And16(a= a, b= notA16, out=zero16 );

    Mux16(a= zero16, b= a, sel= isA, out=maybeA);
    Mux16(a= zero16, b= b, sel= isB, out=maybeB);
    Mux16(a= zero16, b= c, sel= isC, out=maybeC);
    Mux16(a= zero16, b= d, sel= isD, out=maybeD);

    Or16(a= maybeA, b= maybeB, out=maybeAorB );
    Or16(a= maybeC, b= maybeD, out=maybeCorD );

    Or16(a= maybeAorB, b= maybeCorD, out=out );
    
}
